{
  "name": "@mzzsfy/dsh-agent-shell",
  "description": "DSH agent 命令执行面板:自动拉起 @mzzsfy/mcp-ssh 并桥接为 DSH 工具,better-sidebar 标签页人机协同,无侧栏时回退 /agent-shell 页面",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mzzsfy/mcp-ssh": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://git.1014.top:83/mzzsfy/dsh-plugin.git",
    "directory": "packages/dsh-agent-shell"
  },
  "files": [
    "src",
    "test",
    "cordis.patch.yml",
    "README.md"
  ]
}
