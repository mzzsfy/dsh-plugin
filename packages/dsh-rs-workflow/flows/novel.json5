{
  id: "novel", label: "小说写作",
  description: "先定大纲与人物,再逐章写作、章章衔接,终审一致性。适合长短篇小说创作需求。",
  inputs: { chapterCount: "期望章节数;未提供时由大纲步在 3~12 章内自定" },
  steps: [
    { id: "outline", label: "大纲与人物", slot: "planner", prompt: "为需求构思整部小说:确定类型与基调、主要人物表(姓名/动机/关系)、章节数与各章梗概(每章一行:'N. 章节标题——梗概')。期望章节数:{input.chapterCount}(为空则自定 3~12 章)\n创作需求:{request}", outputs: { characters: "人物表:每行一条 '姓名——动机,与他人的关系'", chapters: "章节大纲:每行一条 'N. 章节标题——梗概'" }, listOutputs: ["chapters"] },
    { id: "write-chapter", label: "逐章写作", slot: "executor-loop", for_each: "outline.chapters", mode: "sequential", prompt: "写第{item.index}章,章节任务:{item}\n\n全书需求:{request}\n人物表:{outline.characters}\n上一章梗概:{write-chapter.summary}\n\n写正文(1500 字内),保持与前文一致并自然衔接。", outputs: { summary: "本章 200 字内梗概(供后章衔接)" } },
    { id: "final-review", label: "一致性终审", slot: "reviewer", prompt: "对照大纲与人物表通读各章梗概,检查:情节线闭合、人物动机一致、章节衔接无断裂。输出结论与需修订点。全书需求:{request}", outputs: { verdict: "终审结论:通过 / 需修订(附逐条修订建议)" } },
  ],
}
