{
  id: "default", label: "通用默认",
  description: "评估需求后拆解执行、审查修正、交付汇总的通用流程。任何编码/文档/整理类需求均可直接使用。",
  steps: [
    { id: "triage", label: "需求评估", slot: "planner", prompt: "评估需求:一句话复述目标,列出关键约束与验收口径,拆出执行要点清单。需求:{request}", outputs: { brief: "需求简报:目标、约束、验收口径,各一行", tasks: "执行要点清单:每行一条,按推进顺序" } },
    { id: "execute", label: "执行", after: ["triage"], prompt: "按要点清单逐项完成需求,全部要点须有着落(完成/说明为何不做)。需求:{request}\n简报:{triage.brief}\n要点:{triage.tasks}", outputs: { result: "执行结果:完成了什么、产物/变更清单", pending: "未完成项及原因:每行一条,无则写'无'" } },
    { id: "review", label: "审查", type: "approve", slot: "reviewer-approve", after: ["execute"], target: "execute", onExhausted: "blocked", prompt: "对照需求简报的验收口径审查执行结果:逐口径判定达成与否;未达口径即驳回并列明修正要求。需求:{request}" },
    { id: "deliver", label: "交付汇总", after: ["review"], prompt: "汇总执行结果与审查结论,输出交付说明:做了什么、变更/产物清单、遗留事项。原始需求:{request}", outputs: { report: "交付说明(Markdown:结果/清单/遗留)" } },
  ],
}
