{
  id: "plan-final", label: "计划审定",
  description: "先审计划再动工:计划驳回重拟,僵局即停;任务链执行后终审把关,终审僵局保守修订交付。适合中大型多任务需求。",
  inputs: { brief: "需求简报;经协作分诊路由时由上游注入,独立运行时留空" },
  steps: [
    { id: "plan", label: "制定计划", slot: "planner", prompt: "制定执行计划:拆出任务列表(每行一条,按依赖排序,写清完成判据)与总体思路。需求:{request}\n简报:{input.brief}(为空则以需求原文为准)", outputs: { tasks: "任务列表:每行一条,含完成判据,按依赖排序" }, listOutputs: ["tasks"] },
    { id: "plan-approve", label: "计划审定", type: "approve", slot: "reviewer-approve", after: ["plan"], target: "plan", rounds: 2, onExhausted: "blocked", prompt: "审定计划:任务拆分是否覆盖需求、顺序与判据是否可执行、有无遗漏风险;不通过即驳回并写明重拟要求。需求:{request}" },
    { id: "execute", label: "任务链执行", slot: "executor-loop", for_each: "plan.tasks", mode: "sequential", prompt: "执行任务:{item}(第{item.index}项)\n\n需求:{request}\n上一任务纪要:{execute.note}", outputs: { note: "本任务纪要:做了什么、产出位置(供后续任务衔接)" } },
    { id: "final-approve", label: "终审", type: "approve", slot: "reviewer-approve", after: ["execute"], target: "execute", rounds: 2, onExhausted: "escalate", prompt: "对照计划逐任务终审执行结果:达标放行;不达标驳回并写明逐条修正要求。需求:{request}" },
    { id: "escalate", label: "保守修订", slot: "executor-escalate", prompt: "终审多轮未过,停止返工:按既定任务列表产出最保守的可交付版本,附妥协说明与遗留清单。需求:{request}\n任务列表:{plan.tasks}", outputs: { deliverable: "保守修订交付(Markdown)" } },
  ],
}
