{
  id: "step-review", label: "逐任务审",
  description: "任务链逐项串行执行后整批审定,驳回全链重做,僵局降级交付。适合多步骤强依赖的改造类需求。",
  inputs: { brief: "需求简报;经协作分诊路由时由上游注入,独立运行时留空" },
  steps: [
    { id: "plan", label: "任务拆解", slot: "planner", prompt: "把需求拆为有序任务列表:每行一条,写清任务内容与完成判据;任务强依赖顺序,不设并行项。需求:{request}\n简报:{input.brief}(为空则以需求原文为准)", outputs: { tasks: "任务列表:每行一条,含完成判据" }, listOutputs: ["tasks"] },
    { id: "execute", label: "任务链执行", slot: "executor-loop", for_each: "plan.tasks", mode: "sequential", prompt: "执行任务:{item}(第{item.index}项)\n\n需求:{request}\n上一任务纪要:{execute.note}", outputs: { note: "本任务纪要:做了什么、产出位置(供后续任务衔接)" } },
    { id: "review", label: "批次审定", type: "approve", slot: "reviewer-approve", after: ["execute"], target: "execute", rounds: 2, onExhausted: "escalate", prompt: "对照任务列表逐项审定执行结果:任一任务未达判据即驳回,写明任务序号与修正要求。需求:{request}" },
    { id: "escalate", label: "降级交付", slot: "executor-escalate", prompt: "审定多轮未过,停止返工:汇总已完成任务的实际产出,输出降级交付(已完成部分+未达项清单+原因)。需求:{request}\n任务列表:{plan.tasks}", outputs: { fallback: "降级交付说明(Markdown)" } },
  ],
}
