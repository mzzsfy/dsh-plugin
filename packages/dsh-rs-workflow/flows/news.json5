{
  id: "news", label: "新闻生产",
  description: "围绕主题制定采集计划,多源检索交叉核对后产出事实准确的新闻稿。适合资讯、报道类需求。",
  inputs: { topic: "报道主题;未提供时以请求原文为主题" },
  steps: [
    { id: "plan", label: "采集计划", slot: "planner", prompt: "围绕主题制定信息采集计划:列出检索关键词、可信信息源类型与核对要点。主题:{input.topic}(为空则以需求原文为准)\n需求原文:{request}", outputs: { keywords: "检索关键词列表:每行一条", checkpoints: "核对要点:每行一条,写清判断口径" } },
    { id: "collect", label: "信息采集", after: ["plan"], load: ["skill:web-search"], prompt: "按计划逐源检索与摘录,记录每条信息的来源与时间,不臆造。主题:{input.topic}\n关键词:{plan.keywords}\n核对要点:{plan.checkpoints}", outputs: { facts: "事实清单:每条一行,含'事实——来源——时间'", gaps: "未找到或存疑的信息点:每行一条" } },
    { id: "verify", label: "交叉核对", slot: "reviewer", after: ["collect"], prompt: "对事实清单逐条交叉核对:剔除无源与相互矛盾条目,按核对要点标注置信度(高/中/低)。主题:{input.topic}", outputs: { verified: "核实后事实清单:每条一行,含置信度标注", dropped: "被剔除条目及原因:每行一条" } },
    { id: "write", label: "成稿", after: ["verify"], prompt: "基于核实事实写新闻稿:标题、导语、正文、引用来源;存疑信息不写入正文。主题:{input.topic}", outputs: { article: "新闻稿全文(Markdown,含标题/导语/正文/来源列表)" } },
    { id: "final-review", label: "终审", slot: "reviewer", after: ["write"], prompt: "终审新闻稿:事实是否全部可溯源、表述是否中立、结构是否完整(标题/导语/正文/来源)。给出结论。主题:{input.topic}", outputs: { verdict: "终审结论:通过 / 需修订(附逐条建议)" } },
  ],
}
