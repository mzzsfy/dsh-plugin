{
  // ═══ rs-workflow 工作位绑定（沿用 rs-tui config.json5 的 slot 降级语义）═══
  //
  // 主代理在每次启动工作流时读取本文件，解析后原样传给编排引擎。
  // 降级链：细分位 → 基础位 → 会话默认模型（全部未配置时的行为）。
  //
  // 注意：本文件现在是后备配置——主代理优先用 rs_workflow_config 工具读
  // GUI 设置页 rs-workflow 段的配置（随改随生效）；仅当工具不可用
  // （source=fallback）时才读本文件。
  //
  // 值格式（任选其一）：
  //   "provider/model"                    字符串简写，如 "anthropic/claude-opus-4"
  //   { provider: "...", model: "..." }   对象形式，provider 与 model 可只给一个
  //   ["a/m1", "b/m2"]                    候选数组：依次故障转移；被拒重做/重问
  //                                       从下一候选换模型（节点级轮换）
  //   ""                                  该位未配置，走降级链
  //
  // 角色×模型适配指引：
  //   planner-triage 用快而便宜的模型；executor 用编码强的模型；
  //   reviewer-final 用最强推理的模型；reviewer-plan 中等推理即可。
  //   红线：reviewer 弱于 executor = 审批形同虚设。
  //
  // 修改本文件即时生效，无需重启会话。
  // 注意：provider/model 必须是当前部署的模型路由里真实存在的目标，
  // 配错了对应角色的子代理会调用失败（引擎会重试并降级，但浪费轮次）。

  slots: {
    // ── 基础位（3）──────────────────────────────
    planner: "",   // 规划 / 分诊 / 重规划 / 返工
    executor: "",  // 任务执行
    reviewer: "",  // 审批（逐步审 / 子计划审 / 计划审 pr 兜底 / 交叉终审 B 位）

    // ── 细分位（需要时取消注释并填写）────────────
    // "planner-triage": "",    // 工作流启动时的分诊 + 拆解（建议快而便宜的模型）
    // "planner-escalate": "",  // 升级重规划 / 返工 / 计划重规划（缺省降级 planner）
    // "reviewer-final": "",    // 终审 / 交叉终审 A 位（建议最强推理的模型）
    // "reviewer-plan": "",     // 计划审批 pr 节点（中等推理即可，缺省降级 reviewer）
    // "executor-retry": "",    // 被驳回后的返工执行（可配数组实现换模型重做）
  },
}
