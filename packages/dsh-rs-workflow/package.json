{
  "name": "@mzzsfy/dsh-rs-workflow",
  "description": "若水工作流 v4:人可以在场的强规则编排。单引擎 flow 驱动:接管会话、批次推进、结构化产出契约、审批原语、排队/注入/取消/暂停/断点续跑、全量运行记录回看。设计文档见仓库 docs/rsww-v4/",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "object",
    "url": "git+https://github.com/mzzsfy/dsh-plugin.git"
  },
  "files": [
    "lib",
    "src",
    "engine",
    "preset",
    "flows",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "json5": "^2.2.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
