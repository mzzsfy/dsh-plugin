{
  "name": "@mzzsfy/dsh-rs-workflow",
  "description": "若水工作流:流程模板管理与工作位/预算配置,支持模板可视化编辑与校验、编排运行与活跃任务面板",
  "version": "1.1.4",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@mzzsfy/dsh-common-tools/client"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "unknown"
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "object",
    "url": "git+https://github.com/mzzsfy/dsh-plugin.git"
  },
  "files": [
    "lib",
    "src",
    "engine",
    "preset",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mzzsfy/dsh-common-tools": "^0.2.0"
  }
}
