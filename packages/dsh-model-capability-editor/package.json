{
  "name": "@mzzsfy/dsh-model-capability-editor",
  "description": "在设置页编辑第三方模型的思考档位与图片输入声明,解决手写配置易错与档位拼写不可控",
  "version": "0.1.3",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@mzzsfy/dsh-toast/client"
      ]
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://git.1014.top:83/mzzsfy/dsh-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mzzsfy/dsh-toast": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "files": [
    "src",
    "test",
    "cordis.patch.yml",
    "README.md"
  ]
}
