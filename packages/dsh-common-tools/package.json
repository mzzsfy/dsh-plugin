{
  "name": "@mzzsfy/dsh-common-tools",
  "description": "全家桶公共依赖库:按插件空间隔离的 WebSocket 双向订阅/推送与 toast;host setupCommonTools 借消费插件生命周期激活,client 复用页面单连接;普通 npm 依赖而非 dsh 插件",
  "version": "0.3.0",
  "dependencies": {
    "ws": "^8.22.0"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./host": "./src/host.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "unknown",
        "0.2.1-alpha.1": "unknown"
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzzsfy/dsh-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "test",
    "README.md",
    "兼容性测试.md"
  ]
}
