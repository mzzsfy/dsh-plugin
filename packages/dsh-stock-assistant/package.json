{
  "name": "@mzzsfy/dsh-stock-assistant",
  "version": "0.1.0",
  "description": "股票单页面工具：独立于会话的自选、多平台数据路由与行情查看",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@mzzsfy/dsh-common-tools/client"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "dependencies": {
    "@mzzsfy/dsh-common-tools": "^0.3.0",
    "zod": "^4.6.6"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "兼容性测试.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzzsfy/dsh-plugin.git"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
