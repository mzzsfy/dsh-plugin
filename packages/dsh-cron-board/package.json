{
  "name": "@mzzsfy/dsh-cron-board",
  "description": "轻量级定时任务看板:环境变量集中管理与定时任务调度(croner,支持内联时区后缀 T±N),执行体支持本地脚本与 dsh 会话任务(fresh/pinned 两种会话模式);看板可移入 better-sidebar 侧边栏",
  "version": "0.7.2",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@mzzsfy/dsh-common-tools/client"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "unknown",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --import ./test/_mocks.common-tools.mjs --test \"test/*.test.mjs\"",
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzzsfy/dsh-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mzzsfy/dsh-common-tools": "^0.2.0",
    "croner": "^10.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "files": [
    "src",
    "test",
    "cordis.patch.yml",
    "README.md"
  ]
}
