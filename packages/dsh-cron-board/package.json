{
  "name": "@mzzsfy/dsh-cron-board",
  "description": "轻量级青龙面板:环境变量集中管理与定时任务调度,执行体支持本地脚本与 dsh 会话任务",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzzsfy/dsh-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "croner": "^10.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "files": [
    "src",
    "test",
    "cordis.patch.yml",
    "README.md"
  ]
}
