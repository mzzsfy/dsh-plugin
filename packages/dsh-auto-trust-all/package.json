{
  "name": "@mzzsfy/dsh-auto-trust-all",
  "description": "动态信任所有实际到达的 Host:包装 webServer 路由把 Host 头实时注册进 connection 信任数组(webRuntime 在场时镜像),泛域名入口免改启动命令;不干预监听绑定(由部署层 --host 或宿主缺省决定);认证层(原生 cookie 与 startup-auth 会话)原样保留;推荐与 dsh-web-startup-auth 搭配使用,便于远程开发与反向代理",
  "version": "0.3.2",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "unknown",
        "0.2.1-alpha.2": "compatible"
      }
    },
    "hostMin": "0.2.0-rc.2"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzzsfy/dsh-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "files": [
    "src",
    "test",
    "cordis.patch.yml",
    "README.md"
  ]
}
