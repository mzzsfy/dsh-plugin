{
  "name": "@mzzsfy/dsh-shell-select",
  "description": "Windows shell 接管:替换默认 pwsh 工具为可配置多客户端的 shell 工具(git bash/WSL/cmd/pwsh,自定义路径,默认客户端,模型按名选择);支持命令 deny 黑名单、会话终端卡增强和直接 pwsh 接管徽章,接管失败自动回退官方 pwsh 链",
  "version": "0.5.2",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./executor": "./src/executor.mjs",
    "./guard": "./src/guard.js",
    "./web": "./src/web-routes.mjs",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "hostMin": "0.1.7-rc.1",
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "unknown",
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible",
        "0.2.2-rc.3": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzzsfy/dsh-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-jobs": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-shell": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-timeout": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "js-yaml": "4.3.2"
  },
  "files": [
    "src",
    "test",
    "cordis.patch.yml",
    "运行时接管-BDD.md",
    "兼容性测试.md",
    "README.md"
  ]
}
