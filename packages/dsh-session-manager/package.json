{
  "name": "@mzzsfy/dsh-session-manager",
  "description": "会话自动归档与管理:超期自动归档、归档面板、删除进系统回收站、还原后一键重挂载",
  "version": "0.1.4",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://git.1014.top:83/mzzsfy/dsh-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "react": "^18.2.0",
    "zod": ">=4.5.4"
  },
  "files": [
    "src",
    "test",
    "cordis.patch.yml",
    "README.md"
  ]
