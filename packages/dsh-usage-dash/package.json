{
  "name": "@mzzsfy/dsh-usage-dash",
  "description": "DSH 用量统计:三粒度面板、定价规则、省钱沙盘、成本护栏、异常哨兵与输入区常驻读数",
  "version": "0.15.1",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "unknown",
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible",
        "0.2.2-rc.3": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzzsfy/dsh-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.2",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.1-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": ">=4.5.4"
  },
  "files": [
    "src",
    "test",
    "cordis.patch.yml",
    "README.md",
    "兼容性测试.md"
  ]
}
