{
  "name": "@mzzsfy/dsh-tunnel",
  "description": "穿透隧道:在 dsh 宿主进程内把本地端口反向代理到 /p/<name> 或 <name>.*(监听层按 Host/路径分发,HTTP 与任意 WebSocket 路径均可透传,路径模式改写 3xx Location);GUI 看板手动管理隧道,设置页独立配置节与侧边栏注入开关;向 ai 注册 tunnel_open/tunnel_list/tunnel_close 工具且「允许 ai 使用」可开关(关闭即注销);代理逻辑全在插件进程内,不引入 nginx/caddy 等外部反代",
  "version": "0.1.7",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@mzzsfy/dsh-common-tools/client"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible",
        "0.2.2-rc.3": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --import ./test/_mocks.common-tools.mjs --test \"test/*.test.mjs\"",
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzzsfy/dsh-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mzzsfy/dsh-common-tools": "^0.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2"
  },
  "files": [
    "src",
    "test",
    "cordis.patch.yml",
    "README.md"
  ]
}

